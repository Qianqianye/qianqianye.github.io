---
// Experiment page: a Design & Prototype section (older project entries), then the early creative coding
// sketches listed in src/content/experiments.yaml, which link to the live sketches in the Everyday repo.
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getThumbnail } from '../lib/thumbnails';

// Design & Prototype section: older project entries (hidden from the homepage), in this order
const prototypeIds = [
  'phobia',
  'smart-home',
  'led-light',
  '3d-research',
  'nyc-leading-causes-of-death',
  '50-most-populous-refugee-camps',
  '2015-people-killed-by-police',
  'sf-bike-parking',
];
const projects = await getCollection('projects');
const prototypes = prototypeIds.map((id) => {
  const project = projects.find((p) => p.id === id);
  if (!project) throw new Error(`Prototype "${id}" not found in src/content/projects/.`);
  return project;
});

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/experiments/*', {
  eager: true,
});
const thumbnails = new Map(
  Object.entries(files).map(([path, mod]) => [path.split('/').pop()!, mod.default]),
);

// Same order as written in experiments.yaml
const experiments = (await getCollection('experiments')).sort(
  (a, b) => a.data.position - b.data.position,
);
for (const { data } of experiments) {
  if (!thumbnails.has(data.thumbnail)) {
    throw new Error(`Experiment thumbnail "${data.thumbnail}" not found in src/assets/experiments/.`);
  }
}
---

<BaseLayout
  title="Experiment - Qianqian Ye"
  description="Creative coding experiments by Qianqian Ye, in p5.js, three.js, D3.js, and Unity."
>
  <main class="experiment">
    <!-- Page title for screen readers and search engines; the nav already shows it -->
    <h1 class="visually-hidden">Experiment</h1>

    <section class="intro grid">
      <div class="intro-text">
        <h2>Design &amp; Prototype</h2>
        <p>Interaction design, VR, and data visualization projects, 2016–2017.</p>
      </div>
    </section>

    <section class="sketches grid">
      {
        prototypes.map((project) => (
          <a class="sketch" href={project.data.link ?? `/${project.id}.html`}>
            <Image
              src={getThumbnail(project.data.thumbnail!)}
              alt=""
              widths={[250, 480]}
              quality={60}
              sizes="(max-width: 767px) 50vw, (max-width: 1099px) 16vw, 8vw"
            />
            <span class="title">{project.data.cardTitle ?? project.data.title}</span>
            <span class="meta">{project.data.category} · {project.data.year}</span>
          </a>
        ))
      }
    </section>

    <section class="intro grid text-links">
      <div class="intro-text">
        <h2>Early Creative Coding Experiments</h2>
        <p>
          Sketches made while teaching myself to code, 2016–2018. Built with p5.js, three.js,
          D3.js, and Unity, some made for VR. Source code is on
          <a href="https://github.com/Qianqianye/Everyday">GitHub</a>.
        </p>
      </div>
    </section>

    <section class="sketches grid">
      {
        experiments.map(({ data }, i) => (
          <a class="sketch" href={data.url}>
            <Image
              src={thumbnails.get(data.thumbnail)!}
              alt=""
              widths={[250, 480]}
              quality={60}
              sizes="(max-width: 767px) 50vw, (max-width: 1099px) 16vw, 8vw"
              loading={i < 6 ? 'eager' : 'lazy'}
            />
            <span class="title">{data.title}</span>
            <span class="meta">{data.tools} · {data.year}</span>
          </a>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .intro {
    padding-block: var(--gap) calc(var(--gap) * 2);
  }
  /* More space before the second section */
  .sketches + .intro {
    padding-top: calc(var(--gap) * 4);
  }
  .intro-text {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .intro-text {
      grid-column: 1 / span 4;
    }
  }
  h2 {
    margin: 0 0 0.75em;
    font-size: inherit;
    font-weight: 500;
  }

  /* A denser grid than Works: 2 per row on phones, 6 on tablets, 12 on desktop */
  .sketches {
    row-gap: calc(var(--gap) * 2);
  }
  .sketch {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    /* Smaller text to fit the small tiles */
    font-size: 12px;
    line-height: 1.35;
  }
  @media (min-width: 768px) {
    .sketch {
      grid-column: span 2;
    }
  }
  @media (min-width: 1100px) {
    .sketch {
      grid-column: span 1;
    }
  }
  img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 8px;
  }
  .title {
    font-weight: 500;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9em;
  }
  .sketch:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
