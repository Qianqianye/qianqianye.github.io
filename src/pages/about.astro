<style>
  .about {
    padding-top: var(--gap);
    row-gap: calc(var(--gap) * 3);
  }

  /* Phone: everything stacked. Desktop: photo in columns 1–4, text in 5–10,
     then the three lists side by side, lined up with the homepage thumbnails */
  .portrait,
  .intro,
  .list {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .portrait {
      grid-column: 1 / span 6;
    }
    .intro {
      grid-column: 7 / -1;
    }
    .list {
      grid-column: span 6;
    }
  }
  @media (min-width: 1100px) {
    .portrait {
      grid-column: 1 / span 4;
    }
    .intro {
      grid-column: 5 / span 6;
    }
    .list {
      grid-column: span 4;
    }
  }

  .portrait {
    margin: 0;
  }
  figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.9em;
  }
  figcaption b {
    font-weight: 500;
  }

  h2 {
    margin: 0 0 0.75em;
    font-size: inherit;
    font-weight: 500;
  }
  .intro section + section {
    margin-top: calc(var(--gap) * 2);
  }
  .intro p + p {
    margin-top: 1em;
  }

  /* Year label, then that year's entries */
  .year + .year {
    margin-top: 1.25em;
  }
  h3 {
    margin: 0;
    font-size: inherit;
    font-weight: normal;
    color: var(--muted);
  }
  .list p + p {
    margin-top: 0.4em;
  }

  a {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  a:hover {
    text-decoration-thickness: 2px;
  }
</style>
