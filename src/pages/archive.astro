---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';

// Archive: every project, including ones hidden from the homepage
const projects = (await getCollection('projects', (project) => project.data.thumbnail)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="Archive - Qianqian Ye">
  <main class="archive">
    <ProjectGrid projects={projects} />
  </main>
</BaseLayout>

<style>
  .archive {
    padding-top: var(--gap);
  }
</style>
