---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Teaching - Qianqian Ye">
  <main class="teaching grid">
    <div class="text">
      <h1>Teaching</h1>
      <p>Coming Soon :)</p>
    </div>
  </main>
</BaseLayout>

<style>
  .teaching {
    padding-top: var(--gap);
    min-height: 50vh;
  }
  .text {
    grid-column: 1 / -1;
  }
  @media (min-width: 768px) {
    .text {
      grid-column: 1 / span 4;
    }
  }
  h1 {
    margin: 0 0 0.75em;
    font-size: inherit;
    font-weight: 500;
  }
</style>
