---
// Site header: name, nav, and social links.
// Rendered to static HTML at build time, so it appears with the page instead of after it.
const navLinks = [
  { href: '/about.html', label: 'About' },
  { href: '/', label: 'Works' },
  { href: 'https://qianqianye.github.io/Everyday/', label: 'Experiment' },
  { href: '/teaching.html', label: 'Teaching' },
];

const socialLinks = [
  { href: 'https://github.com/Qianqianye', icon: 'fa-github', label: 'GitHub' },
  { href: 'https://twitter.com/4444ian', icon: 'fa-twitter', label: 'Twitter' },
  { href: 'https://www.linkedin.com/in/qianqianye', icon: 'fa-linkedin', label: 'LinkedIn' },
  { href: 'http://instagram.com/44ian', icon: 'fa-instagram', label: 'Instagram' },
];
---

<section id="header">
  <div class="container">
    <div class="topbar">
      <div id="header-site-title">
        <a href="/">Qianqian Ye</a>
      </div>
      <div id="header-nav-wrapper">
        <ul id="nav" class="full">
          {navLinks.map((link) => (
            <li>
              <a href={link.href}><span class="count hide-on-mobile"></span>{link.label}</a>
            </li>
          ))}
        </ul>
        <div id="menu-mobile-wrapper">
          <div id="toggle-menu" role="button" aria-label="Menu" tabindex="0"></div>
          <ul id="menu-mobile">
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="socialbtns">
      <ul>
        {socialLinks.map((link) => (
          <li><a href={link.href} class={`fa fa-lg ${link.icon}`} aria-label={link.label}></a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Mobile menu toggle (ported from the old js/load-nav.js)
  const toggleMenu = document.getElementById('toggle-menu');
  const mobileWrapper = document.getElementById('menu-mobile-wrapper');
  const mobileMenu = document.getElementById('menu-mobile');

  function openMenu() {
    mobileWrapper.classList.add('toggle-open');
    mobileMenu.style.display = 'block';
    requestAnimationFrame(() => {
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + 'px';
    });
  }

  function closeMenu() {
    mobileWrapper.classList.remove('toggle-open');
    mobileMenu.style.maxHeight = '0';
    // Wait for the CSS transition to finish before hiding
    setTimeout(() => {
      mobileMenu.style.display = 'none';
    }, 300);
  }

  if (toggleMenu && mobileWrapper && mobileMenu) {
    toggleMenu.addEventListener('click', (e) => {
      e.stopPropagation();
      mobileWrapper.classList.contains('toggle-open') ? closeMenu() : openMenu();
    });

    document.addEventListener('click', (e) => {
      if (!mobileWrapper.contains(e.target) && mobileWrapper.classList.contains('toggle-open')) {
        closeMenu();
      }
    });
  }
</script>
