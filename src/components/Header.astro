// Highlight the nav link for the current section; project pages count as Works
const path = Astro.url.pathname;
const current = path.startsWith('/about')
  ? '/about.html'
  : path.startsWith('/experiment')
    ? '/experiment.html'
    : path.startsWith('/teaching')
      ? '/teaching.html'
      : '/';
---

<header class="site-header grid">
  <a class="name" href="/">Qianqian Ye</a>
  <nav class="nav" aria-label="Main">
    {
      navLinks.map((link) => (
        <a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <ul class="social">
    {
      socialLinks.map((link) => (
        <li>
          <a href={link.href} aria-label={link.label}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={link.path} /></svg>
          </a>
        </li>
      ))
    }
  </ul>
</header>

<style>
  .site-header {
    padding-block: var(--margin);
    row-gap: 4px;
  }
  /* Nav links and icons are soft grey and turn black on hover; the name stays black.
     The current page is black and underlined. */
  .nav a,
  .social a {
    color: var(--soft);
    transition: color 0.15s;
  }
  .nav a:hover,
  .social a:hover,
  .nav a[aria-current='page'] {
    color: var(--fg);
  }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Phone: name left and icons right on the first line, nav stacked under the name */
  .name {
    grid-column: 1 / span 2;
    grid-row: 1;
  }
  .nav {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-top: 0.75em;
  }
  .social {
    grid-column: 3 / -1;
    grid-row: 1;
    justify-self: end;
    align-self: center;
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social svg {
    display: block;
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .social a {
    display: block;
  }

  /* Tablet and up: one line, aligned to the thumbnail columns below */
  @media (min-width: 768px) {
    .name {
      grid-column: 1 / span 4;
    }
    .nav {
      grid-column: 5 / span 4;
      grid-row: 1;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.2em;
      margin-top: 0;
    }
    .social {
      grid-column: 9 / -1;
    }
  }
</style>
