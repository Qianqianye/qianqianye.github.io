---
// One square thumbnail with its title and category underneath.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getThumbnail } from '../lib/thumbnails';

interface Props {
  project: CollectionEntry<'projects'>;
  // Load immediately instead of when scrolled into view (for the first row)
  eager?: boolean;
}

const { project, eager = false } = Astro.props;
const { title, cardTitle, category, year, thumbnail, link } = project.data;
const href = link ?? `/${project.id}.html`;
// Label under the image: "Category · Year" (first year only, e.g. "2021, ongoing" → "2021")
const label = [category, year?.match(/\d{4}/)?.[0]].filter(Boolean).join(' · ');
// Animated GIFs are heavy, so they get stronger compression; still images stay sharper.
// (Astro never enlarges past the original, so the 1200px version only exists for large originals.)
const isGif = thumbnail?.toLowerCase().endsWith('.gif');
---

<a class="card" href={href}>
  {
    thumbnail && (
      <Image
        src={getThumbnail(thumbnail)}
        alt=""
        widths={[400, 800, 1200]}
        quality={isGif ? 60 : 80}
        sizes="(max-width: 767px) 100vw, (max-width: 1099px) 50vw, 33vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    )
  }
  <span class="title">{cardTitle ?? title}</span>
  {label && <span class="category">{label}</span>}
</a>

<style>
  /* Phone: full width; tablet: 2 per row; desktop: 3 per row */
  .card {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 768px) {
    .card {
      grid-column: span 6;
    }
  }
  @media (min-width: 1100px) {
    .card {
      grid-column: span 4;
    }
  }
  img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin-bottom: 10px;
  }
  .title {
    font-weight: 500;
  }
  .category {
    color: var(--muted);
    font-size: 0.9em;
  }
  .card:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
</style>
